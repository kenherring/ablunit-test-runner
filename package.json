{
	"name": "ablunit-test-runner",
	"displayName": "ABLUnit Test Runner",
	"description": "OpenEdge ABLUnit test runner for VSCode",
	"version": "1.4.43",
	"engineStrict": true,
	"galleryBanner": {
		"color": "#007ACC",
		"theme": "dark"
	},
	"publisher": "kherring",
	"pricing": "Free",
	"private": true,
	"icon": "resources/images/icon_128.png",
	"author": "Ken Herring",
	"qna": false,
	"homepage": "https://github.com/kenherring/ablunit-test-runner/blob/main/README.md",
	"repository": {
		"url": "https://github.com/kenherring/ablunit-test-runner"
	},
	"bugs": {
		"url": "https://github.com/kenherring/ablunit-test-runner/issues"
	},
	"license": "MIT",
	"licenses": [
		{
			"type": "MIT",
			"url": "https://github.com/kenherring/ablunit-test-runner/blob/main/LICENSE"
		}
	],
	"badges": [
		{
			"href": "https://github.com/kenherring/ablunit-test-runner/actions/workflows/main.yml",
			"url": "https://github.com/kenherring/ablunit-test-runner/actions/workflows/main.yml/badge.svg",
			"description": "GitHub Actions"
		},
		{
			"href": "https://sonarcloud.io/summary/new_code?id=kenherring_ablunit-test-runner",
			"url": "https://sonarcloud.io/api/project_badges/measure?project=kenherring_ablunit-test-runner&metric=sqale_rating",
			"description": "SonarCloud Maintainability Rating"
		},
		{
			"href": "https://sonarcloud.io/summary/new_code?id=kenherring_ablunit-test-runner",
			"url": "https://sonarcloud.io/api/project_badges/measure?project=kenherring_ablunit-test-runner&metric=coverage",
			"description": "SonarCloud Coverage"
		}
	],
	"capabilities": {
		"untrustedWorkspaces": {
			"supported": false
		}
	},
	"keywords": [
		"4gl",
		"abl",
		"ablunit",
		"oeunit",
		"openedge",
		"pdsoe",
		"progress"
	],
	"engines": {
		"vscode": "^1.96.0"
	},
	"categories": [
		"Testing"
	],
	"activationEvents": [
		"onStartupFinished",
		"workspaceContains:{**/*.cls,**/*.p,.vscode/ablunit-test-profile.json}"
	],
	"main": "./dist/extension.js",
	"scripts": {
		"build": "node esbuild.js",
		"rebuild": "npm run clean && npm run build",
		"clean": "sh -c scripts/npm_clean.sh",
		"lint": "eslint",
		"lint-fix-all": "eslint --fix",
		"vscode:prepublish": "npm run package",
		"package": "npm run build",
		"pretest": "sh -c scripts/npm_pretest.sh",
		"test": "vscode-test",
		"test:coverage": "npm test -- --coverage",
		"vscode-test": "vscode-test",
		"test:install-and-run": "cd dummy-ext && npm run test:install-and-run",
		"version": "sh -c scripts/npm_version.sh",
		"watch": "npm run build -- --watch"
	},
	"dependencies": {
		"minimatch": "^10.2.6",
		"node-json-minify": "^3.0.0",
		"tree-kill": "^1.2.2",
		"xml2js": "^0.6.2"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.2",
		"@types/mocha": "^10.0.10",
		"@types/node": "24.x",
		"@types/vscode": "1.96.0",
		"@types/xml2js": "^0.4.14",
		"@vscode/test-cli": "^0.0.15",
		"@vscode/test-electron": "^3.1.0",
		"@vscode/vsce": "^4.0.0",
		"esbuild": "^0.28.2",
		"esbuild-register": "^3.6.0",
		"eslint": "^9.39.2",
		"eslint-plugin-promise": "^7.3.0",
		"mocha": "^12.0.3",
		"mocha-multi-reporters": "^1.5.2",
		"mocha-reporter-sonarqube": "2.1.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.72.0"
	},
	"contributes": {
		"configuration": {
			"type": "object",
			"title": "ABLUnit Test Runner",
			"properties": {
				"ablunit.discoverAllTestsOnActivate": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "For large workspaces this may improve performance by loading test files as they are used instead of all at once"
				},
				"ablunit.explorer.classlabel": {
					"type": "string",
					"title": "Class Label",
					"default": "filepath",
					"enum": [
						"class-type-name",
						"filepath"
					],
					"markdownEnumDescriptions": [
						"**example:** `class.path.className`",
						"**example:** `class/path/className.cls`"
					],
					"markdownDescription": "Label style for test class files in the test explorer view. <br><br>Example styles for `com/example/myClass.cls`:\n<ul><li>class-type-name\\: `com.example.myClass`</li><li>filename\\: `myClass.cls`</li></ul>"
				},
				"ablunit.debug.hide": {
					"type": "boolean",
					"default": false,
					"markdownDescription": "Hide debug tests run button in the test explorer view. Extension must be reloaded for this setting to take effect."
				},
				"ablunit.files.include": {
					"type": "array",
					"default": [
						"**/*.{cls,p}"
					],
					"markdownDescription": "Glob patterns to include test files",
					"scope": "machine-overridable"
				},
				"ablunit.files.exclude": {
					"type": "array",
					"default": [
						"**/.builder/**",
						"**/.pct/**"
					],
					"markdownDescription": "Glob patterns to exclude test files",
					"scope": "machine-overridable"
				},
				"ablunit.suggest.enabled": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "Enable/disable autocomplete suggestions."
				},
				"ablunit.suggest.annotations": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "Enable/disable autocomplete suggestions for ABLUnit annotations."
				},
				"ablunit.suggest.events": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "Enable/disable autocomplete suggestions for `[block | routine]-level` statements."
				},
				"ablunit.suggest.methods": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "Enable/disable autocomplete suggestions for methods."
				},
				"ablunit.suggest.references": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "Enable/disable autocomplete suggestions for references."
				}
			}
		},
		"languages": [
			{
				"id": "abl",
				"aliases": [
					"OpenEdge ABL"
				],
				"extensions": [
					".cls",
					".i",
					".p",
					".w"
				]
			},
			{
				"id": "jsonc",
				"filenamePatterns": [
					"**/ablunit-test-profile*.json"
				]
			}
		],
		"jsonValidation": [
			{
				"fileMatch": [
					"**/ablunit-test-profile*.json"
				],
				"url": "./resources/ablunit-test-profile.schema.json"
			}
		],
		"menus": {
			"editor/title": [
				{
					"command": "ablunit.showDebugListingPreview",
					"when": "editorLangId == abl && !notebookEditorFocused && (resourceExtname == '.cls' || resourceExtname == '.p')",
					"group": "navigation"
				}
			],
			"explorer/context": [
				{
					"command": "ablunit.showDebugListingPreview",
					"when": "resourceLangId == abl && (resourceExtname == '.cls' || resourceExtname == '.p')",
					"group": "1_ablunit@1"
				}
			],
			"editor/context": [
				{
					"command": "ablunit.showDebugListingPreview",
					"when": "resourceLangId == abl && (resourceExtname == '.cls' || resourceExtname == '.p')",
					"group": "1_ablunit@1"
				}
			]
		},
		"commands": [
			{
				"command": "ablunit.showDebugListingPreview",
				"title": "Show debug listing Preview",
				"category": "ABLUnit",
				"icon": "$(open-preview)",
				"enablement": "resourceExtname == '.cls' || resourceExtname == '.p'"
			}
		],
		"languageModelTools": [
			{
				"name": "ablunit_list_tests",
				"toolReferenceName": "ablunitListTests",
				"displayName": "List ABLUnit Tests",
				"userDescription": "List the ABLUnit tests discovered in the workspace or in a file.",
				"modelDescription": "Lists the OpenEdge ABLUnit tests (test classes, test programs, test suites and their test methods/procedures) discovered by the ABLUnit Test Runner extension. Use it to find which tests exist and their exact names before running them with ablunit_run_tests. When fileUri is omitted, lists every test in the workspace.",
				"canBeReferencedInPrompt": true,
				"icon": "$(beaker)",
				"tags": [
					"ablunit",
					"openedge",
					"abl",
					"tests"
				],
				"inputSchema": {
					"type": "object",
					"properties": {
						"fileUri": {
							"type": "string",
							"description": "Test file (.cls or .p): workspace-relative path, absolute path, or file URI."
						}
					}
				}
			},
			{
				"name": "ablunit_run_tests",
				"toolReferenceName": "ablunitRunTests",
				"displayName": "Run ABLUnit Tests",
				"userDescription": "Run ABLUnit tests and report the results.",
				"modelDescription": "Runs OpenEdge ABLUnit tests with the ABLUnit Test Runner extension (same configuration as the Test Explorer 'Run Tests' profile: .vscode/ablunit-test-profile.json and openedge-project.json) and returns the totals plus, for every test that did not pass, its failure message, expected/actual values and call stack. Compile errors and ABLUnit runtime errors are reported as well. Omit fileUri to run every test in the workspace; pass fileUri to run the tests in one file; pass fileUri and testName to run a single test method or procedure. Tests run against the files saved on disk.",
				"canBeReferencedInPrompt": true,
				"icon": "$(beaker)",
				"tags": [
					"ablunit",
					"openedge",
					"abl",
					"tests"
				],
				"inputSchema": {
					"type": "object",
					"properties": {
						"fileUri": {
							"type": "string",
							"description": "Test file (.cls or .p): workspace-relative path, absolute path, or file URI."
						},
						"testName": {
							"type": "string",
							"description": "Name of a single test method (test class) or internal procedure (test program) inside fileUri, as returned by ablunit_list_tests. Case-insensitive. Requires fileUri."
						}
					}
				}
			}
		]
	}
}
